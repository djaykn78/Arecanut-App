<?xml version="1.0" encoding="utf-8"?>
<!-- Save this as: res/layout/activity_main.xml -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_arecanut"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="40dp">

        <!-- ===== HEADER ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI POWERED"
                    android:textColor="#E8C97A"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arecanut Maturity\nPredictor"
                    android:textColor="#F7F0E3"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.1" />
            </LinearLayout>

            <!-- Badge icon -->
            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="🌿"
                android:textSize="22sp"
                android:gravity="center"
                android:background="@drawable/bg_badge"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- ===== IMAGE PREVIEW CARD ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_card"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"
                android:visibility="gone" />

            <!-- Placeholder when no image -->
            <LinearLayout
                android:id="@+id/placeholderView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#1AFFFFFF">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:text="🚫"
                    android:textSize="30sp"
                    android:gravity="center"
                    android:background="@drawable/bg_icon_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No image selected"
                    android:textColor="#99F7F0E3"
                    android:textSize="13sp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

        </FrameLayout>

        <!-- ===== BUTTONS ===== -->

        <!-- Select from Gallery -->
        <Button
            android:id="@+id/btnGallery"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="📁  SELECT IMAGE FROM GALLERY"
            android:textColor="#F7F0E3"
            android:textSize="13sp"
            android:letterSpacing="0.1"
            android:background="@drawable/bg_btn_glass"
            android:elevation="4dp" />

        <!-- Take Photo -->
        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="📷  TAKE PHOTO WITH CAMERA"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:letterSpacing="0.1"
            android:background="@drawable/bg_btn_green"
            android:elevation="4dp" />

        <!-- Predict -->
        <Button
            android:id="@+id/btnPredict"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:text="🔍  PREDICT MATURITY"
            android:textColor="#0F2412"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:background="@drawable/bg_btn_gold"
            android:enabled="false"
            android:elevation="4dp" />

        <!-- ===== RESULT CARD ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <!-- Big emoji status icon -->
            <ImageView
                android:id="@+id/ivResultIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/app_logo"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_result_icon_circle"
                android:padding="4dp"
                android:layout_marginEnd="16dp"
                android:clipToOutline="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Sub label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MATURITY STATUS"
                    android:textColor="#88F7F0E3"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="4dp" />

                <!-- Main result text — BIG & BOLD -->
                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#F7F0E3"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.0" />

                <!-- Confidence text -->
                <TextView
                    android:id="@+id/tvConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#99F7F0E3"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />


            </LinearLayout>
        </LinearLayout>


    </LinearLayout>
</ScrollView>
